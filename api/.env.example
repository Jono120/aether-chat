PORT=8080
DATABASE_URL=postgresql://aetheradmin:aether@localhost:5432/aether
DEV_AUTH_BYPASS=true
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@aether.local
ADMIN_PASSWORD=ChangeMe-Admin-2026!
ADMIN_ENTRA_OID=local:administrator
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:5173
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SIGNALR_CONNECTION_STRING=
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_DELETION_QUEUE=account-deletion
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
# SMTP (optional — password reset emails; dev returns devResetToken when SMTP unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aether.local
# Optional — inbox for new error-report alerts (defaults to ADMIN_EMAIL)
SUPPORT_ALERT_EMAIL=
# Optional — app store URLs returned by GET /api/v1/config/mobile-links
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
# Optional — comma-separated request headers for GET /api/v1/config/locale (Cloudflare, Azure Front Door, etc.)
GEO_COUNTRY_HEADERS=cf-ipcountry,x-country-code,x-forwarded-country
# Production: disable in-process purge (use api/workers/purge)
WORKER_PURGE_ONLY=false

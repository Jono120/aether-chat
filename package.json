{
  "name": "optimistic-pasteur",
  "description": "Aether — Secure E2EE Dating Grid (Local Prototype): client-only React demo with simulated E2EE chat, privacy center, and EXIF tooling.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "vite build",
    "build:mobile": "node scripts/mobile-sync.mjs",
    "mobile:setup": "node scripts/mobile-setup.mjs",
    "mobile:sync": "node scripts/mobile-sync.mjs",
    "mobile:install": "npm ci --prefix mobile",
    "mobile:build:ci": "node scripts/mobile-sync.mjs",
    "mobile:android:debug": "cd mobile/android && ./gradlew assembleDebug",
    "mobile:android:release": "cd mobile/android && ./gradlew bundleRelease",
    "mobile:ios:sim": "xcodebuild -workspace mobile/ios/App/App.xcworkspace -scheme App -destination 'platform=iOS Simulator,name=iPhone 16' -configuration Debug build",
    "mobile:open:android": "npm run open:android --prefix mobile",
    "mobile:open:ios": "npm run open:ios --prefix mobile",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:responsive": "node scripts/responsive-audit.mjs",
    "test:i18n": "node --test src/i18n/countryLocaleMap.test.js"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@microsoft/signalr": "^8.0.7",
    "i18next": "^26.3.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.52.0",
    "vite": "^8.0.12"
  }
}

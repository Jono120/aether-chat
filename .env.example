# SPA — optional backend integration (omit to use local mocks)
VITE_API_URL=http://localhost:8080
VITE_DEV_USER_ID=dev-user-1
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Optional — Azure SignalR hub URL hint (negotiate uses API when VITE_API_URL is set)
VITE_SIGNALR_URL=
# Optional — app store links for WebAlbumBlockedBanner (https URLs only)
# Set before first production web deploy after mobile apps are listed in the stores.
VITE_IOS_APP_STORE_URL=
VITE_ANDROID_PLAY_STORE_URL=
# Server-side override (when API deployed): IOS_APP_STORE_URL / ANDROID_PLAY_STORE_URL in api/.env
